{
  "name": "whatsapp-self-knowledge-assistant",
  "version": "9.3.0",
  "description": "Multi-user WhatsApp AI assistant: every user gets their own keys, business profile and session. Speaks 86 languages, scores leads, answers missed calls in chat, and never loses a reply to a bad connection.",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dry": "DRY_RUN=1 ENABLE_WEB=1 node src/index.js",
    "doctor": "node scripts/doctor.js",
    "chat": "node scripts/simulate.js",
    "session": "node scripts/session-backup.js",
    "test": "node --test test/*.test.js",
    "demo": "node scripts/seed-demo.js && DRY_RUN=1 DATA_DIR=./data/demo ENABLE_WEB=1 node src/index.js",
    "seed": "node scripts/seed-demo.js",
    "tenant": "node scripts/tenant.js",
    "all": "node scripts/run-all.js",
    "users": "node scripts/tenant.js list",
    "doctor:all": "node scripts/doctor.js all",
    "doctor:live": "node scripts/doctor.js all --live",
    "templates": "node scripts/tenant.js templates",
    "setup": "node scripts/tenant.js setup"
  },
  "keywords": [
    "whatsapp",
    "ai",
    "assistant",
    "baileys",
    "groq",
    "gemini",
    "voice",
    "vision",
    "crm"
  ],
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^9.1.4",
    "@whiskeysockets/baileys": "^6.7.9",
    "dotenv": "^16.4.5",
    "franc": "^6.2.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "sql.js": "^1.12.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}
