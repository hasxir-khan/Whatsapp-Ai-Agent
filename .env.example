# ════════════════════════════════════════════════════════════
#  WhatsApp Self-Knowledge Assistant — configuration
#  Copy this file to .env and fill in the keys you have.
#  Everything is optional except MY_NUMBER + one AI key.
# ════════════════════════════════════════════════════════════

# ── You ────────────────────────────────────────────────────
MY_NUMBER=923001234567          # your WhatsApp number, international format, no +
MY_NAME=YourName
MY_BRAND=YourBrand
MY_TIMEZONE=Asia/Karachi
# MY_PERSONALITY=Warm, direct, slightly informal. Short WhatsApp messages.
# MY_BIO=We sell coffee, cakes and breakfast.

# ── AI keys (all have free tiers) ──────────────────────────
# Groq: chat + Whisper speech-to-text. Free: https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio: images AND video understanding. Free: https://aistudio.google.com/api-keys
# Current keys start with "AQ."; the legacy "AIza…" format still works.
GEMINI_API_KEY=

# Optional third option for vision if Gemini is busy. Free models available.
OPENROUTER_API_KEY=

# ── Transport: Baileys (default) or the official Cloud API ──
# baileys = free, needs a phone with WhatsApp installed (QR / pairing code)
# cloud   = Meta's official API, no phone needed while running, needs a free
#           Meta developer account and a public HTTPS webhook
# Read README → "Switching to the official Cloud API" before changing this.
TRANSPORT=baileys

# Only for TRANSPORT=cloud. All four are required together.
# CLOUD_PHONE_ID=123456789012345      # Meta → WhatsApp → API setup → Phone number ID
# CLOUD_TOKEN=EAAG...                 # a permanent system-user token, not the 24h test one
# CLOUD_VERIFY_TOKEN=any-word-you-choose   # you type it in Meta too; Meta echoes it back
# CLOUD_APP_SECRET=abcdef123456       # Meta → App settings → Basic → App secret
# CLOUD_API_VERSION=v21.0
# Optional: an approved template for messages outside the 24-hour window.
# CLOUD_TEMPLATE_NAME=hello_world
# CLOUD_TEMPLATE_LANG=en

# ── Missed calls ───────────────────────────────────────────
# When a client calls and nobody answers within this many seconds, the
# assistant replies in chat (voice note and/or text) so the lead isn't lost.
# WhatsApp's web protocol cannot carry live call audio — this is the closest
# thing that exists on a $0 budget.
CALLS_ENABLED=true
# The wait window is random on purpose — 60–90 s, like someone noticing.
CALL_DELAY_MIN_SECONDS=60
CALL_DELAY_MAX_SECONDS=90
# CALL_FALLBACK_SECONDS=60      # set this to pin a single fixed delay instead
# One apology per contact per 30 minutes, however often they ring.
CALL_APOLOGY_WINDOW_MIN=30
# CALL_APOLOGY_VOICE=false      # also send the apology as a voice note
# auto | voice_note | text
CALL_FALLBACK_MODE=auto
# auto | formal | casual
CALL_FALLBACK_TONE=auto
CALL_FALLBACK_MAX_PER_DAY=3

# ── Login ──────────────────────────────────────────────────
# Easiest on a server: log in with a pairing code instead of a QR.
# Put your number here, start the bot, and enter the 8-digit code in WhatsApp.
# PAIRING_NUMBER=923001234567

# Free hosts that wipe the disk: paste the blob from `npm run session` here
# so you never have to re-pair after a redeploy.
# WA_SESSION=

# ── Behaviour ──────────────────────────────────────────────
# Voice replies: off | on_request | match_voice | always
# match_voice (default) answers a voice note with a voice note.
VOICE_REPLY_MODE=match_voice
# TTS_MAX_SECONDS=20             # spoken part is cut at a sentence boundary
# TTS_GREET_VOICE=false          # voice note for the very first message too
# PRETEND_HUMAN=false            # true = never say it's a bot (read README first)
DEBOUNCE_MS=2200                 # wait this long for the client to finish typing
HUMAN_TOUCH=on                   # 👍 for "ok/thanks"; the honest bot answer is never optional

# ── Reply timing (human-feel pass) ─────────────────────────
# The customer's message to the reply is 5–15 s: read at 1–3 s, then typing
# for as long as the answer needs (3–10 s), then the message. A reply that is
# already late goes out at once — nothing is padded to look slow.
REPLY_TIMING=true
REPLY_TARGET_MIN_MS=5000
REPLY_TARGET_MAX_MS=15000
READ_DELAY_MIN_MS=1000
READ_DELAY_MAX_MS=3000
TYPING_MIN_MS=3000
TYPING_MAX_MS=10000
TYPING_CPS=11                    # characters per second "typed" by the indicator
TYPING_REFRESH_MS=8000           # re-send "typing…" so WhatsApp never drops it
TYPING_HARD_CAP_MS=30000         # after this, stop pretending to type
HOLDING_AFTER_MS=30000           # past this, send one short "one sec" line
REPLY_MAX_SENTENCES=2            # quotes, lists and "explain in detail" are exempt
HANDOFF_MINUTES=45               # when you reply yourself, the bot stays quiet this long
READ_RECEIPTS=true
# QUIET_HOURS=01:00-07:00        # optional: bot goes silent
# DEFER_QUIET_HOURS=false        # true = hold replies until quiet hours end
NOTIFY_NEW_CHATS=true
ESCALATE_TO_OWNER=true
FOLLOWUP_HOURS=20
FOLLOWUP_MAX=2
AUTO_BLOCK_SCAM=false

# ── Limits (protects the free tiers) ───────────────────────
DAILY_LLM_CALLS=700
DAILY_VISION_CALLS=150
DAILY_TTS_CHARS=20000
MAX_VIDEO_MB=48                 # legacy native-video path
# Protected media: opt in per tenant in owner.json (README → Voice and video).
# MEDIA_VIDEO_MB=25
# MEDIA_VIDEO_SECONDS=60
# MEDIA_VIDEO_FRAMES=6
# MEDIA_PROVIDER_TIMEOUT_MS=20000
# MEDIA_VIDEOS_DAY=10
# MEDIA_VIDEOS_MONTH=120
# MEDIA_VISION_CALLS_DAY=30
# MEDIA_VISION_CALLS_MONTH=300
MAX_IMAGE_MB=16
MAX_AUDIO_SECONDS=600
HISTORY_TURNS=16
SUMMARY_EVERY=12

# ── Models (defaults are chosen to exist; change if you like) ──
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# GROQ_SMALL_MODEL=openai/gpt-oss-20b
# Customer replies use this budget. Too small and a list comes out as "1, 2, 3, 4,".
# LLM_REPLY_MAX_TOKENS=1000
# How long one provider may take before the chain moves on, and the order it moves in.
# LLM_TIMEOUT_MS=45000
# LLM_PROVIDERS=groq,gemini,openrouter
# OpenRouter answers only with a model named here, always last in the chain.
# OPENROUTER_ALLOWED_MODELS=meta-llama/llama-3.3-70b-instruct:free
# Newest first; if one disappears the next is used automatically.
# GEMINI_MODEL=gemini-4-hydrogen
# GEMINI_MODELS=gemini-4-hydrogen,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# GEMINI_VISION_MODEL=gemini-4-hydrogen
# GEMINI_VISION_MODELS=gemini-4-hydrogen,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# Keep the key in the x-goog-api-key header (default) or send it as a bearer token.
# GEMINI_AUTH_STYLE=key
# WHISPER_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=                  # empty = auto-detect the speaker's language
# TTS_VOICE=en-US-AriaNeural     # force one voice for every reply
# FFMPEG_PATH=                   # only if ffmpeg isn't on PATH

# ── Server / dashboard ─────────────────────────────────────
PORT=3000
HOST=0.0.0.0
ENABLE_WEB=true
# DRY_RUN=true                   # dashboard only, no WhatsApp connection

# ── Growth agents (Phase 3) ────────────────────────────────
# Each agent is switched on per business in config/owner.json:
#   features.bookingAgent, features.followUpAgent   (default false)
#   features.growthApproval                          (default true — drafts
#     wait for .approve / .skip instead of sending by themselves)
# These are the shared safety-layer limits for everything proactive.
# GROWTH_CONTACT_CAP=1           # max proactive messages per person per 24h
# GROWTH_DAILY_CAP=30            # max per day for the whole assistant
# GROWTH_BAILEYS_CAP=12          # lower ceiling automatically used on Baileys
# GROWTH_QUIET_START=21:00       # quiet hours, in business.timezone
# GROWTH_QUIET_END=09:00
# GROWTH_MIN_SCORE=40            # follow up only if the lead scores this high
# GROWTH_FOLLOWUP_HOURS=24,72    # hours of silence that trigger a follow-up
# GROWTH_FOLLOWUP_MAX=2          # then the lead is marked cold

# ── Analyst / closer / review agents (Phase 3, part 2) ─────
# Switched on per business in config/owner.json:
#   features.analystAgent, features.closerAgent, features.reviewAgent (default false)
# ANALYST_DAY=mon                # weekly report day (business timezone)
# ANALYST_TIME=09:00             # and hour
# REVIEW_AFTER_HOURS=24          # wait after .done before asking for feedback
# CLOSER_MAX_ATTEMPTS=2          # then the owner takes over the objection

# ── Reactivation + content agents (Phase 3, part 3) ────────
# Switched on per business: features.reactivationAgent, features.contentAgent.
# REACTIVATION_AFTER_DAYS=45      # a job must be this old before we ask again
# REACTIVATION_MAX_CYCLES=2       # unanswered nudges, then silence
# REACTIVATION_COOLDOWN_DAYS=180  # how long that silence lasts
# REACTIVATION_MIN_GAP_MS=120000  # slow sending: gap between two messages
# REACTIVATION_MAX_GAP_MS=420000
# CONTENT_DAY=wed                 # weekly content pack day + time
# CONTENT_TIME=10:00

# ── PDF quotes, invoices and receipts (Phase 4) ────────────
# Switched on per business: features.pdfInvoices, features.selfHealing.
# INVOICE_KEEP_DAYS=90            # old PDFs are swept on every new one
# SELF_HEALING_WINDOW_MINUTES=30  # how soon after the bot a manual reply counts
# SELF_HEALING_MAX_PER_DAY=3      # proposals per day, hard cap

# Public base URL for links the bot sends (e.g. the inbox link in .inbox).
# Only affects what is printed, never how the server binds.
# PUBLIC_URL=https://bot.yourdomain.com

# ── Multi-tenant safety ────────────────────────────────────
# One tenant can never spend the whole free quota on its own.
# TENANT_DAILY_LLM_CALLS=250
# Set a token if the dashboard is reachable from the internet.
# DASHBOARD_TOKEN=

# ── Reliability alerts (Phase 5 Part 1) ────────────────────
# config/owner.json: features.healthAlerts (default false)
# ALERT_WEBHOOK_URL=https://ntfy.sh/your-topic   # second channel when WhatsApp is down
# ALERT_COOLDOWN_MINUTES=30      # repeat a still-broken alert no more often
# ALERT_OUTBOX_MINUTES=10        # replies stuck this long are an incident
# ALERT_RECONNECTS=3             # N reconnects …
# ALERT_RECONNECT_WINDOW_MINUTES=10
# SLA_ALERT_MINUTES=15           # a customer waiting this long, business hours only
# ALERT_INCLUDE_CONTENT=false    # true adds the contact's name to an SLA ping
# BACKUP_MAX_AGE_DAYS=7
# BACKUP_DIR=./backups
# DISK_WARN_PERCENT=10
# DISK_BAD_PERCENT=5
# HEALTH_CHECK_SECONDS=60

# ── Privacy tools (Phase 5 Part 1) ─────────────────────────
# config/owner.json: features.privacyTools (default false)
# PRIVACY_RETENTION_DAYS=0       # 0 = keep forever; N = purge bodies older than N days

# ── External tools / MCP (Phase 4 Part 5) ──────────────────
# config/owner.json: features.mcpTools (default false), features.mcpWriteTools
# The server list is the OPERATOR's file. Never put it in a tenant folder.
# MCP_SERVERS_FILE=/etc/whatsapp/mcp.servers.json
# MCP_SERVERS_ROOT=/opt/wa-tools   # tool servers may only run under here
# MCP_DAILY_CAP=200                # calls per tenant per day
# npm install @modelcontextprotocol/sdk   # optional; without it the feature is off

# ── Visual search (Phase 4 Part 4) ─────────────────────────
# config/owner.json: features.visualSearch. Local CLIP, free, no API key.
# npm install @xenova/transformers   # optional; without it photos go to Gemini
# VISUAL_HIGH_THRESHOLD=0.88   # at or above: this is that item
# VISUAL_LOW_THRESHOLD=0.78    # between low and high: show the top 3, ask
# VISUAL_SEARCH_DAILY_CAP=300  # lookups per tenant per day

# ── Admin panel (Phase 4 Part 3) ────────────────────────────
# One page to run every tenant: create, profile, keys, QR, start/stop.
# Off by default: config/owner.json -> "features": { "adminPanel": true }
# Its own secret — never the same value as DASHBOARD_TOKEN. Without it the
# /admin routes answer 404 rather than opening up.
# ADMIN_TOKEN=long-random-string
# ADMIN_SESSION_MINUTES=720
# Bind HOST=127.0.0.1 and put a tunnel in front; never expose the port.

# ── Google Calendar (optional) ─────────────────────────────
# Bookings are stored in SQLite and synced to Sheets regardless. These only
# mirror new bookings into a calendar — leave them empty to skip.
# GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# ── Orders + mini CRM (Phase 5 Part 2) ─────────────────────
# Both are off by default. Turn them on in config/owner.json:
#   "features": { "orderTracking": true, "crm": true }
#
# Hours an unpaid order waits before the first and second (last) reminder.
# Leave unset to use business.orderReminders in config/owner.json (12 / 36).
# ORDER_REMINDER_HOURS=12
# ORDER_REMINDER_SECOND_HOURS=36
#
# A contact with no messages for this many days can be auto-tagged "cold".
# Only used when features.crm is on; no message is sent by tagging.
# CRM_COLD_DAYS=45

# ── Optional extras ────────────────────────────────────────
DAILY_REPORT=true
REPORT_HOUR=9
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}
LOG_LEVEL=info

# ── Optional customer platform (off by default) ──────────────
# Configure these on the control plane, NOT in tenant folders or browser code.
# Generate each secret separately once (openssl rand -base64 48); keep them
# stable across redeploys. The master secret does not belong with DB backups.
# PLATFORM_ENABLED=1
# PLATFORM_SECRET=
# PLATFORM_KEY_SECRET=
# PLATFORM_DIR=./platform/data
# PLATFORM_PORT=3200
# PLATFORM_PUBLIC_URL=https://assistants.example.com
# Production refuses a non-HTTPS public URL. Insecure exception: PLATFORM_ALLOW_HTTP=1.
# Pin the socket peer, not the end-user's IP. Choose the header your ingress sets.
# PLATFORM_TRUST_PROXY=xff:10.0.0.2
# PLATFORM_TRUST_PROXY=cf:127.0.0.1
# PLATFORM_MAILER=http
# PLATFORM_MAIL_URL=https://api.resend.com/emails
# PLATFORM_MAIL_FROM=Assistant <verify@example.com>
# PLATFORM_MAIL_TOKEN=
# Local only: PLATFORM_MAILER=file (default), PLATFORM_DEV_SHOW_CODES=1
# Unmanaged bots may also configure GROQ_API_KEY_2 / _3, GEMINI_API_KEY_2 / _3
# and OPENROUTER_API_KEY_2 / _3. Managed assistants use the dashboard instead.
# LLM_KEY_SOURCE=tenant  # 'platform' is reserved and explicitly refused

# Customer reports (also requires PLATFORM_ENABLED). After changing this flag,
# restart the platform and its managed live workers via the existing supervisor.
# PLATFORM_DASHBOARD=1
# Dedicated optional fleet login at /platform/operator: username operator,
# independent random HTTPS Basic credential (openssl rand -base64 48).
# PLATFORM_OPERATOR_TOKEN=
# Optional direct link to each tenant's separately authenticated live inbox:
# PLATFORM_INBOX_ORIGIN=https://{slug}.inbox.example.com
