# ════════════════════════════════════════════════════════════
#  WhatsApp Self-Knowledge Assistant — configuration
#  Copy this file to .env and fill in the keys you have.
#  Everything is optional except MY_NUMBER + one AI key.
# ════════════════════════════════════════════════════════════

# ── You ────────────────────────────────────────────────────
MY_NUMBER=923169896229          # your WhatsApp number, international format, no +
MY_NAME=Hashir
MY_BRAND=HasDevs
MY_TIMEZONE=Asia/Karachi
# MY_PERSONALITY=Warm, direct, slightly informal. Short WhatsApp messages.
# MY_BIO=I build websites, apps and AI automation.

# ── AI keys (all have free tiers) ──────────────────────────
# Groq: chat + Whisper speech-to-text. Free: https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio: images AND video understanding. Free: https://aistudio.google.com/api-keys
# Current keys start with "AQ."; the legacy "AIza…" format still works.
GEMINI_API_KEY=

# Optional third option for vision if Gemini is busy. Free models available.
OPENROUTER_API_KEY=

# ── Missed calls ───────────────────────────────────────────
# When a client calls and nobody answers within this many seconds, the
# assistant replies in chat (voice note and/or text) so the lead isn't lost.
# WhatsApp's web protocol cannot carry live call audio — this is the closest
# thing that exists on a $0 budget.
CALLS_ENABLED=true
CALL_FALLBACK_SECONDS=60
# auto | voice_note | text
CALL_FALLBACK_MODE=auto
# auto | formal | casual
CALL_FALLBACK_TONE=auto
CALL_FALLBACK_MAX_PER_DAY=3

# ── Login ──────────────────────────────────────────────────
# Easiest on a server: log in with a pairing code instead of a QR.
# Put your number here, start the bot, and enter the 8-digit code in WhatsApp.
# PAIRING_NUMBER=923169896229

# Free hosts that wipe the disk: paste the blob from `npm run session` here
# so you never have to re-pair after a redeploy.
# WA_SESSION=

# ── Behaviour ──────────────────────────────────────────────
# Voice replies: off | on_request | match_voice | always
VOICE_REPLY_MODE=on_request
# PRETEND_HUMAN=false            # true = never say it's a bot (read README first)
DEBOUNCE_MS=2200                 # wait this long for the client to finish typing
HANDOFF_MINUTES=45               # when you reply yourself, the bot stays quiet this long
READ_RECEIPTS=true
# QUIET_HOURS=01:00-07:00        # optional: bot goes silent
# DEFER_QUIET_HOURS=false        # true = hold replies until quiet hours end
NOTIFY_NEW_CHATS=true
ESCALATE_TO_OWNER=true
FOLLOWUP_HOURS=20
FOLLOWUP_MAX=2
AUTO_BLOCK_SCAM=false

# ── Limits (protects the free tiers) ───────────────────────
DAILY_LLM_CALLS=700
DAILY_VISION_CALLS=150
DAILY_TTS_CHARS=20000
MAX_VIDEO_MB=48
MAX_IMAGE_MB=16
MAX_AUDIO_SECONDS=600
HISTORY_TURNS=16
SUMMARY_EVERY=12

# ── Models (defaults are chosen to exist; change if you like) ──
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# GROQ_SMALL_MODEL=openai/gpt-oss-20b
# Newest first; if one disappears the next is used automatically.
# GEMINI_MODEL=gemini-4-hydrogen
# GEMINI_MODELS=gemini-4-hydrogen,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# GEMINI_VISION_MODEL=gemini-4-hydrogen
# GEMINI_VISION_MODELS=gemini-4-hydrogen,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# Keep the key in the x-goog-api-key header (default) or send it as a bearer token.
# GEMINI_AUTH_STYLE=key
# WHISPER_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=                  # empty = auto-detect the speaker's language
# TTS_VOICE=en-US-AriaNeural     # force one voice for every reply
# FFMPEG_PATH=                   # only if ffmpeg isn't on PATH

# ── Server / dashboard ─────────────────────────────────────
PORT=3000
HOST=0.0.0.0
ENABLE_WEB=true
# DRY_RUN=true                   # dashboard only, no WhatsApp connection

# ── Optional extras ────────────────────────────────────────
DAILY_REPORT=true
REPORT_HOUR=9
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}
LOG_LEVEL=info
